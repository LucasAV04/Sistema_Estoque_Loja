<Page x:Class="EstoqueLoja.WPF.Views.EntradaPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#F3F4F6"
      FontFamily="Segoe UI">

    <Page.Resources>
        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>
        <Style x:Key="InputStyle" TargetType="TextBox">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="White" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="7">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#1B2A4A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SuccessButton" TargetType="Button">
            <Setter Property="Height" Value="44"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#065F46"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#047857"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="b" Property="Background" Value="#9CA3AF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="0,4,0,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- CABEÇALHO -->
            <StackPanel Grid.Row="0" Margin="0,0,0,18">
                <TextBlock Text="Entrada de Estoque" FontSize="26" FontWeight="Bold" Foreground="#111827"/>
                <TextBlock Text="Registre a chegada de novos itens para produtos já cadastrados"
                           FontSize="12" Foreground="#6B7280" Margin="0,2,0,0"/>
            </StackPanel>

            <!-- CARD: PESQUISA -->
            <Border Grid.Row="1" Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="Pesquisar Produto" FontSize="14" FontWeight="SemiBold"
                               Foreground="#374151" Margin="0,0,0,10"/>

                    <Grid>
                        <TextBox x:Name="TxtBusca" Style="{StaticResource InputStyle}"
                                 TextChanged="TxtBusca_TextChanged"/>
                        <TextBlock Text="Digite o nome ou referência do produto..."
                                   Foreground="#9CA3AF" Margin="12,0,0,0" FontSize="13"
                                   VerticalAlignment="Center" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=TxtBusca}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <Border x:Name="BorderResultados" Margin="0,8,0,0"
                            BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="7"
                            Visibility="Collapsed">
                        <ListBox x:Name="ListResultados" MaxHeight="160" BorderThickness="0"
                                 Background="White" SelectionChanged="ListResultados_SelectionChanged">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="12,8"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#EFF6FF"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Background="#EFF6FF" CornerRadius="4" Padding="6,2">
                                            <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="#1D4ED8">
                                                <Run Text="REF: "/><Run Text="{Binding Ref}"/>
                                            </TextBlock>
                                        </Border>
                                        <TextBlock Grid.Column="2" Text="{Binding Nome}"
                                                   FontSize="13" Foreground="#111827"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </StackPanel>
            </Border>

            <!-- CARD: PRODUTO SELECIONADO -->
            <Border Grid.Row="2" x:Name="CardProduto" Style="{StaticResource CardBorder}"
                    Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="Produto Selecionado" FontSize="14" FontWeight="SemiBold"
                               Foreground="#374151" Margin="0,0,0,10"/>

                    <Border Background="#F9FAFB" CornerRadius="7" Padding="14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Referência" FontSize="11" Foreground="#6B7280"/>
                                <TextBlock x:Name="TxtRef" FontSize="14" FontWeight="SemiBold"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Nome" FontSize="11" Foreground="#6B7280"/>
                                <TextBlock x:Name="TxtNome" FontSize="14" FontWeight="SemiBold"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Tipo" FontSize="11" Foreground="#6B7280"/>
                                <TextBlock x:Name="TxtTipo" FontSize="14" FontWeight="SemiBold"/>
                            </StackPanel>

                            <Border Grid.Column="3" Background="#EBF5FB" CornerRadius="7" Padding="14,8">
                                <StackPanel>
                                    <TextBlock Text="ESTOQUE ATUAL" FontSize="10"
                                               FontWeight="SemiBold" Foreground="#1A5276"/>
                                    <TextBlock x:Name="TxtEstoqueAtual" Text="0"
                                               FontSize="22" FontWeight="Bold" Foreground="#1A5276"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- CARD: DADOS DA ENTRADA -->
            <Border Grid.Row="3" x:Name="CardEntrada" Style="{StaticResource CardBorder}"
                    Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="Dados da Entrada" FontSize="14" FontWeight="SemiBold"
                               Foreground="#374151" Margin="0,0,0,10"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Quantidade" FontSize="11" Foreground="#6B7280" Margin="0,0,0,4"/>
                            <TextBox x:Name="TxtQuantidade" Style="{StaticResource InputStyle}" Text="1"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Motivo" FontSize="11" Foreground="#6B7280" Margin="0,0,0,4"/>
                            <ComboBox x:Name="CmbMotivo" Height="36" FontSize="13" SelectedIndex="0">
                                <ComboBoxItem Content="Compra"/>
                                <ComboBoxItem Content="Reposição"/>
                                <ComboBoxItem Content="Devolução"/>
                                <ComboBoxItem Content="Ajuste"/>
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <StackPanel Margin="0,12,0,0">
                        <TextBlock Text="Observação (opcional)" FontSize="11" Foreground="#6B7280" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtObservacao" Style="{StaticResource InputStyle}" Height="60"
                                 AcceptsReturn="True" TextWrapping="Wrap"
                                 VerticalContentAlignment="Top" Padding="10,8"/>
                    </StackPanel>

                    <Button x:Name="BtnRegistrar" Content="✔  Registrar Entrada"
                            Style="{StaticResource SuccessButton}"
                            Width="220" HorizontalAlignment="Right" Margin="0,16,0,0"
                            Click="BtnRegistrar_Click"/>
                </StackPanel>
            </Border>

        </Grid>
    </ScrollViewer>
</Page>