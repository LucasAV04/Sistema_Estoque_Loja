<Page x:Class="EstoqueLoja.WPF.Views.ProdutosPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="White">

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>

		<!-- TÍTULO -->
		<TextBlock Grid.Row="0"
                   Text="Produtos"
                   FontSize="26"
                   FontWeight="Bold"
                   Margin="0,0,0,20"/>

		<!-- PESQUISA E FILTRO -->
		<Grid Grid.Row="1"
              Margin="0,0,0,15">

			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="280"/>
				<ColumnDefinition Width="15"/>
				<ColumnDefinition Width="160"/>
				<ColumnDefinition Width="*"/>
			</Grid.ColumnDefinitions>

			<!-- BARRA DE PESQUISA -->
			<Grid Grid.Column="0">

				<TextBox x:Name="TxtBusca"
                         Height="28"
                         VerticalContentAlignment="Center"
                         TextChanged="TxtBusca_TextChanged"
                         ToolTip="Pesquise pelo nome ou pela referência do produto"/>

				<TextBlock Text="Pesquisar por nome ou referência..."
                           Foreground="#9CA3AF"
                           Margin="8,0,0,0"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False">

					<TextBlock.Style>
						<Style TargetType="TextBlock">
							<Setter Property="Visibility" Value="Collapsed"/>

							<Style.Triggers>
								<DataTrigger Binding="{Binding Text, ElementName=TxtBusca}" Value="">
									<Setter Property="Visibility" Value="Visible"/>
								</DataTrigger>
							</Style.Triggers>
						</Style>
					</TextBlock.Style>

				</TextBlock>

			</Grid>

			<!-- FILTRO TIPO -->
			<ComboBox x:Name="CmbTipo"
                      Grid.Column="2"
                      Height="30"
                      SelectionChanged="CmbTipo_SelectionChanged"
                      VerticalContentAlignment="Center">

				<ComboBoxItem Content="Todos"/>
				<ComboBoxItem Content="cadeira"/>
				<ComboBoxItem Content="mesa"/>

			</ComboBox>

		</Grid>
		<Border Grid.Row="2"
				Background="#F3F4F6"
				Padding="10"
				CornerRadius="8"
				Margin="0,0,0,15">

			<TextBlock x:Name="TxtTotalVenda"
					   Text="Total valor da venda unitária: R$ 0,00"
					   FontSize="15"
					   FontWeight="SemiBold"/>
		</Border>

		<!-- TABELA DE PRODUTOS -->
		<DataGrid Grid.Row="3"
          x:Name="GridProdutos"
          AutoGenerateColumns="False"
          IsReadOnly="True"
		  MouseDoubleClick="GridProdutos_MouseDoubleClick">

			<DataGrid.Columns>
				<DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="60"/>
				<DataGridTextColumn Header="Ref" Binding="{Binding Ref}" Width="120"/>
				<DataGridTextColumn Header="Nome" Binding="{Binding Nome}" Width="*"/>
				<DataGridTextColumn Header="Tipo" Binding="{Binding Tipo}" Width="120"/>
				<DataGridTextColumn Header="Compra" Binding="{Binding Valor_Compra}" Width="120"/>
				<DataGridTextColumn Header="Venda" Binding="{Binding Valor_Venda}" Width="120"/>
			</DataGrid.Columns>

		</DataGrid>

	</Grid>

</Page>