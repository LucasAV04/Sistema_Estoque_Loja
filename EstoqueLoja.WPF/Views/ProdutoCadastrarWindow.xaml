<Window x:Class="EstoqueLoja.WPF.Views.ProdutoCadastrarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Novo Produto"
        Height="460"
        Width="440"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F3F4F6"
        FontFamily="Segoe UI">

    <Window.Resources>

        <!-- Labels -->
        <Style x:Key="Lbl" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#4B5563"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
        </Style>

        <!-- TextBox padrão -->
        <Style x:Key="Inp" TargetType="TextBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="Background" Value="White"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">

                        <Border x:Name="Borda"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6">

                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Borda"
                                        Property="BorderBrush"
                                        Value="#1B2A4A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>

                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- CABEÇALHO -->
        <Border Grid.Row="0"
                Background="#1B2A4A"
                Padding="20,14">

            <StackPanel>
                <TextBlock Text="Novo Produto"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="White"/>

                <TextBlock Text="O estoque inicial será zero. Use a tela Entrada para adicionar quantidade."
                           FontSize="11"
                           Foreground="#9CA3AF"
                           Margin="0,3,0,0"
                           TextWrapping="Wrap"/>
            </StackPanel>

        </Border>

        <!-- FORMULÁRIO -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto">

            <StackPanel Margin="20,16,20,8">

                <!-- Referência e Tipo -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="Referência *"
                                   Style="{StaticResource Lbl}"/>

                        <TextBox x:Name="TxtRef"
                                 Style="{StaticResource Inp}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Tipo *"
                                   Style="{StaticResource Lbl}"/>

                        <TextBox x:Name="TxtTipo"
                                 Style="{StaticResource Inp}"/>
                    </StackPanel>
                </Grid>

                <!-- Nome -->
                <StackPanel Margin="0,10,0,0">
                    <TextBlock Text="Nome *"
                               Style="{StaticResource Lbl}"/>

                    <TextBox x:Name="TxtNome"
                             Style="{StaticResource Inp}"/>
                </StackPanel>

                <!-- Descrição -->
                <StackPanel Margin="0,10,0,0">

                    <TextBlock Text="Descrição"
                               Style="{StaticResource Lbl}"/>

                    <TextBox x:Name="TxtDescricao"
                             Height="60"
                             Padding="10,8"
                             FontSize="13"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             BorderBrush="#D1D5DB"
                             Background="White"
                             VerticalScrollBarVisibility="Auto">

                        <TextBox.Template>

                            <ControlTemplate TargetType="TextBox">

                                <Border x:Name="BordaDescricao"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6">

                                    <ScrollViewer x:Name="PART_ContentHost"
                                                  Margin="{TemplateBinding Padding}"/>

                                </Border>

                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsFocused"
                                             Value="True">

                                        <Setter TargetName="BordaDescricao"
                                                Property="BorderBrush"
                                                Value="#1B2A4A"/>

                                    </Trigger>
                                </ControlTemplate.Triggers>

                            </ControlTemplate>

                        </TextBox.Template>

                    </TextBox>

                </StackPanel>

                <!-- Valores -->
                <Grid Margin="0,10,0,0">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>

                        <TextBlock Text="Valor de Compra"
                                   Style="{StaticResource Lbl}"/>

                        <TextBox x:Name="TxtValorCompra"
                                 Style="{StaticResource Inp}"
                                 Text="0,00"/>

                    </StackPanel>

                    <StackPanel Grid.Column="2">

                        <TextBlock Text="Valor de Venda *"
                                   Style="{StaticResource Lbl}"/>

                        <TextBox x:Name="TxtValorVenda"
                                 Style="{StaticResource Inp}"
                                 Text="0,00"/>

                    </StackPanel>

                </Grid>

                <!-- Aviso -->
                <Border Background="#FEF3C7"
                        BorderBrush="#FCD34D"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="12,8"
                        Margin="0,14,0,0">

                    <TextBlock Text="⚠ Produto criado com estoque 0. Acesse Entrada para adicionar quantidade."
                               FontSize="11"
                               Foreground="#92400E"
                               TextWrapping="Wrap"/>

                </Border>

            </StackPanel>

        </ScrollViewer>

        <!-- RODAPÉ -->
        <Border Grid.Row="2"
                Background="White"
                BorderBrush="#E5E7EB"
                BorderThickness="0,1,0,0"
                Padding="20,12">

            <Grid>

                <!-- Cancelar -->
                <Button Content="Cancelar"
                        Width="100"
                        Height="36"
                        HorizontalAlignment="Left"
                        FontSize="13"
                        Foreground="#374151"
                        Background="White"
                        BorderBrush="#D1D5DB"
                        BorderThickness="1"
                        Cursor="Hand"
                        Click="BtnCancelar_Click">

                    <Button.Template>
                        <ControlTemplate TargetType="Button">

                            <Border x:Name="b"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6">

                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>

                            </Border>

                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver"
                                         Value="True">

                                    <Setter TargetName="b"
                                            Property="Background"
                                            Value="#F3F4F6"/>

                                </Trigger>
                            </ControlTemplate.Triggers>

                        </ControlTemplate>
                    </Button.Template>

                </Button>

                <!-- Salvar -->
                <Button x:Name="BtnSalvar"
                        Content="Salvar Produto"
                        Width="140"
                        Height="36"
                        HorizontalAlignment="Right"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Foreground="White"
                        Background="#1B2A4A"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="BtnSalvar_Click">

                    <Button.Template>
                        <ControlTemplate TargetType="Button">

                            <Border x:Name="b"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="6">

                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>

                            </Border>

                            <ControlTemplate.Triggers>

                                <Trigger Property="IsMouseOver"
                                         Value="True">

                                    <Setter TargetName="b"
                                            Property="Background"
                                            Value="#243460"/>

                                </Trigger>

                                <Trigger Property="IsEnabled"
                                         Value="False">

                                    <Setter TargetName="b"
                                            Property="Background"
                                            Value="#9CA3AF"/>

                                </Trigger>

                            </ControlTemplate.Triggers>

                        </ControlTemplate>
                    </Button.Template>

                </Button>

            </Grid>

        </Border>

    </Grid>
</Window>