<Window x:Class="EstoqueLoja.WPF.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sistema de Estoque"
        Height="650"
        Width="1100"
        MinHeight="600"
        MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="#F3F4F6">

    <Grid ClipToBounds="True">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- MENU LATERAL -->
        <Border Grid.Column="0"
                Background="#111827">

            <StackPanel Margin="20">

                <!-- LOGO / TÍTULO -->
                <TextBlock Text="Estoque Loja"
                           Foreground="White"
                           FontSize="24"
                           FontWeight="Bold"
                           Margin="0,0,0,20"/>

                <!-- USUÁRIO LOGADO -->
                <Border Background="#1F2937"
                        CornerRadius="8"
                        Padding="10"
                        Margin="0,0,0,25">

                    <StackPanel>

                        <TextBlock Text="Usuário Logado"
                                   Foreground="#9CA3AF"
                                   FontSize="12"/>

                        <TextBlock x:Name="TxtUsuarioLogado"
                                   Foreground="White"
                                   FontSize="15"
                                   FontWeight="SemiBold"/>

                        <TextBlock x:Name="TxtRoleLogada"
                                   Foreground="#60A5FA"
                                   FontSize="13"
                                   FontWeight="Bold"/>

                    </StackPanel>

                </Border>

                <!-- MENU -->

                <Button Content="Produtos"
                        Height="40"
                        Margin="0,0,0,10"
                        Click="BtnProdutos_Click"/>

                <Button Content="Estoque"
                        Height="40"
                        Margin="0,0,0,10"
                        Click="BtnEstoque_Click"/>

                <Button Content="Venda"
                        Height="40"
                        Margin="0,0,0,10"
                        Click="BtnVenda_Click"/>

                <Button Content="Entrada / Saida"
                        Height="40"
                        Margin="0,0,0,10"
                        Click="BtnSaida_Click"/>

                <Button Content="Histórico"
                        Height="40"
                        Margin="0,0,0,10"
                        Click="BtnHistorico_Click"/>

                <Button Content="Sair"
                        Height="40"
                        Margin="0,30,0,0"
                        Click="BtnSair_Click"/>

            </StackPanel>

        </Border>

        <!-- CONTEÚDO PRINCIPAL -->
        <Grid Grid.Column="1"
              Background="White"
              ClipToBounds="True">

            <Frame x:Name="FramePrincipal"
                   Margin="25"
                   NavigationUIVisibility="Hidden"/>

        </Grid>

    </Grid>

</Window>