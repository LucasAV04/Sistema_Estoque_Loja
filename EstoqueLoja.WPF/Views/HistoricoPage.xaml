<Page x:Class="EstoqueLoja.WPF.Views.HistoricoPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#F3F4F6"
      FontFamily="Segoe UI">

    <Page.Resources>
        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>
        <Style x:Key="FiltroBtn" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="b" Background="Transparent"
                                BorderBrush="#D1D5DB" BorderThickness="1"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#1B2A4A"/>
                                <Setter TargetName="b" Property="BorderBrush" Value="#1B2A4A"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#F3F4F6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- CABEÇALHO -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Histórico de Movimentações" FontSize="26" FontWeight="Bold" Foreground="#111827"/>
            <TextBlock Text="Todas as entradas, vendas e saídas registradas no sistema"
                       FontSize="12" Foreground="#6B7280" Margin="0,2,0,0"/>
        </StackPanel>

        <!-- FILTROS -->
        <Border Grid.Row="1" Style="{StaticResource CardBorder}">
            <StackPanel>

                <!-- Pesquisa -->
                <Grid Margin="0,0,0,12">
                    <TextBox x:Name="TxtBusca" Height="34"
                             VerticalContentAlignment="Center"
                             FontSize="13" BorderBrush="#D1D5DB"
                             TextChanged="AplicarFiltros">
                        <TextBox.Template>
                            <ControlTemplate TargetType="TextBox">
                                <Border Background="White" BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="1" CornerRadius="7">
                                    <ScrollViewer x:Name="PART_ContentHost" Margin="10,0"
                                                  VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsFocused" Value="True">
                                        <Setter Property="BorderBrush" Value="#1B2A4A"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </TextBox.Template>
                    </TextBox>
                    <TextBlock Text="Pesquisar por produto ou referência..."
                               Foreground="#9CA3AF" Margin="12,0,0,0"
                               VerticalAlignment="Center" FontSize="13" IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=TxtBusca}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <!-- Filtro Tipo -->
                <StackPanel Margin="0,0,0,10">
                    <TextBlock Text="Tipo" FontSize="11" FontWeight="SemiBold"
                               Foreground="#6B7280" Margin="0,0,0,6"/>
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="RbTodos" Content="Todos" GroupName="Tipo"
                                     IsChecked="True" Style="{StaticResource FiltroBtn}"
                                     Margin="0,0,6,0" Checked="AplicarFiltros"/>
                        <RadioButton x:Name="RbEntrada" Content="Entradas" GroupName="Tipo"
                                     Style="{StaticResource FiltroBtn}"
                                     Margin="0,0,6,0" Checked="AplicarFiltros"/>
                        <RadioButton x:Name="RbVenda" Content="Vendas" GroupName="Tipo"
                                     Style="{StaticResource FiltroBtn}"
                                     Margin="0,0,6,0" Checked="AplicarFiltros"/>
                        <RadioButton x:Name="RbSaida" Content="Saídas" GroupName="Tipo"
                                     Style="{StaticResource FiltroBtn}"
                                     Checked="AplicarFiltros"/>
                    </StackPanel>
                </StackPanel>

                <!-- Filtro Período -->
                <StackPanel>
                    <TextBlock Text="Período" FontSize="11" FontWeight="SemiBold"
                               Foreground="#6B7280" Margin="0,0,0,6"/>
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="RbHoje" Content="Hoje" GroupName="Periodo"
                                     Style="{StaticResource FiltroBtn}"
                                     Margin="0,0,6,0" Checked="AplicarFiltros"/>
                        <RadioButton x:Name="Rb7dias" Content="7 dias" GroupName="Periodo"
                                     Style="{StaticResource FiltroBtn}"
                                     Margin="0,0,6,0" Checked="AplicarFiltros"/>
                        <RadioButton x:Name="Rb30dias" Content="30 dias" GroupName="Periodo"
                                     IsChecked="True" Style="{StaticResource FiltroBtn}"
                                     Margin="0,0,6,0" Checked="AplicarFiltros"/>
                        <RadioButton x:Name="RbTodoPeriodo" Content="Tudo" GroupName="Periodo"
                                     Style="{StaticResource FiltroBtn}"
                                     Checked="AplicarFiltros"/>
                    </StackPanel>
                </StackPanel>

            </StackPanel>
        </Border>

        <!-- RESUMO -->
        <Border Grid.Row="2" Style="{StaticResource CardBorder}" Padding="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="#F0FDF4" CornerRadius="8"
                        Padding="14,10" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="ENTRADAS" FontSize="10" FontWeight="SemiBold" Foreground="#6B7280"/>
                        <TextBlock x:Name="TxtResEntradas" Text="0" FontSize="22"
                                   FontWeight="Bold" Foreground="#065F46"/>
                        <TextBlock x:Name="TxtResEntradasQtd" Text="0 unidades"
                                   FontSize="11" Foreground="#6B7280"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Background="#EFF6FF" CornerRadius="8"
                        Padding="14,10" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="VENDAS" FontSize="10" FontWeight="SemiBold" Foreground="#6B7280"/>
                        <TextBlock x:Name="TxtResVendas" Text="0" FontSize="22"
                                   FontWeight="Bold" Foreground="#1D4ED8"/>
                        <TextBlock x:Name="TxtResVendasQtd" Text="0 unidades"
                                   FontSize="11" Foreground="#6B7280"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Background="#FEF2F2" CornerRadius="8"
                        Padding="14,10" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="SAÍDAS" FontSize="10" FontWeight="SemiBold" Foreground="#6B7280"/>
                        <TextBlock x:Name="TxtResSaidas" Text="0" FontSize="22"
                                   FontWeight="Bold" Foreground="#DC2626"/>
                        <TextBlock x:Name="TxtResSaidasQtd" Text="0 unidades"
                                   FontSize="11" Foreground="#6B7280"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="3" Background="#F5F3FF" CornerRadius="8"
                        Padding="14,10">
                    <StackPanel>
                        <TextBlock Text="TOTAL" FontSize="10" FontWeight="SemiBold" Foreground="#6B7280"/>
                        <TextBlock x:Name="TxtResTotal" Text="0" FontSize="22"
                                   FontWeight="Bold" Foreground="#6D28D9"/>
                        <TextBlock Text="movimentações" FontSize="11" Foreground="#6B7280"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- TABELA -->
        <Border Grid.Row="3" Style="{StaticResource CardBorder}" Padding="0" Margin="0">
            <DataGrid x:Name="GridHistorico"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      BorderThickness="0"
                      GridLinesVisibility="Horizontal"
                      RowBackground="White"
                      AlternatingRowBackground="#F9FAFB"
                      CanUserResizeRows="False"
                      SelectionMode="Single"
                      MouseDoubleClick="GridHistorico_MouseDoubleClick"
                      Margin="4">

                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#F3F4F6"/>
                        <Setter Property="Foreground" Value="#374151"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="FontSize" Value="12"/>
                        <Setter Property="Padding" Value="12,8"/>
                        <Setter Property="BorderThickness" Value="0"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>

                <DataGrid.Columns>

                    <DataGridTextColumn Header="Data / Hora"
                                        Binding="{Binding CreatedAt, StringFormat=dd/MM/yyyy HH:mm}"
                                        Width="140">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Padding" Value="12,8"/>
                                <Setter Property="Foreground" Value="#374151"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="Usuário"
                                        Binding="{Binding Usuario}"
                                        Width="110">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Padding" Value="12,8"/>
                                <Setter Property="Foreground" Value="#374151"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Tipo com cor -->
                    <DataGridTemplateColumn Header="Tipo" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="5" Padding="8,3" Margin="8,4"
                                        Background="{Binding TipoBadgeBg}">
                                    <TextBlock Text="{Binding Tipo}"
                                               FontSize="11" FontWeight="SemiBold"
                                               Foreground="{Binding TipoBadgeFg}"
                                               HorizontalAlignment="Center"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="Ref"
                                        Binding="{Binding RefProduto}"
                                        Width="90">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Padding" Value="12,8"/>
                                <Setter Property="Foreground" Value="#6B7280"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="Produto"
                                        Binding="{Binding NomeProduto}"
                                        Width="*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Padding" Value="12,8"/>
                                <Setter Property="Foreground" Value="#111827"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Quantidade com cor -->
                    <DataGridTemplateColumn Header="Quantidade" Width="110">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding QuantidadeFormatada}"
                                           Foreground="{Binding QuantidadeCor}"
                                           FontWeight="Bold" FontSize="13"
                                           Padding="12,8" HorizontalAlignment="Right"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="Motivo"
                                        Binding="{Binding Origem}"
                                        Width="110">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Padding" Value="12,8"/>
                                <Setter Property="Foreground" Value="#6B7280"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                </DataGrid.Columns>
            </DataGrid>
        </Border>

    </Grid>
</Page>