<Window x:Class="EstoqueLoja.WPF.Views.HistoricoVendasWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Histórico de Vendas"
        Height="560"
        Width="780"
        WindowStartupLocation="CenterOwner"
        Background="#F3F4F6"
        FontFamily="Segoe UI">

    <Window.Resources>

        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="20"/>
        </Style>

        <Style x:Key="HeaderButton" TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#1B2A4A"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#243460"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#152038"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerButton" TargetType="Button">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#C0392B"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#A93226"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#922B21"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- CABEÇALHO -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Histórico de Vendas"
                           FontSize="22"
                           FontWeight="Bold"
                           Foreground="#111827"/>
                <TextBlock x:Name="TxtSubtitulo"
                           Text="Carregando..."
                           FontSize="12"
                           Foreground="#6B7280"
                           Margin="0,2,0,0"/>
            </StackPanel>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
                <Button Content="↻  Atualizar"
                        Style="{StaticResource HeaderButton}"
                        Margin="0,0,8,0"
                        Click="BtnAtualizar_Click"/>
                <Button Content="Fechar"
                        Style="{StaticResource HeaderButton}"
                        Background="#6B7280"
                        Click="BtnFechar_Click"/>
            </StackPanel>
        </Grid>

        <!-- BARRA DE BUSCA -->
        <Border Grid.Row="1"
                Style="{StaticResource CardBorder}"
                Padding="14,10"
                Margin="0,0,0,12">
            <Grid>
                <TextBox x:Name="TxtBusca"
                         Height="32"
                         VerticalContentAlignment="Center"
                         TextChanged="TxtBusca_TextChanged"
                         FontSize="13"/>
                <TextBlock Text="Filtrar por nº da venda ou nome do produto..."
                           Foreground="#9CA3AF"
                           Margin="10,0,0,0"
                           VerticalAlignment="Center"
                           FontSize="13"
                           IsHitTestVisible="False">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=TxtBusca}" Value="">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Border>

        <!-- GRID DE VENDAS -->
        <Border Grid.Row="2"
                Style="{StaticResource CardBorder}"
                Padding="0"
                Margin="0,0,0,12">
            <DataGrid x:Name="GridHistorico"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      BorderThickness="0"
                      GridLinesVisibility="Horizontal"
                      RowBackground="White"
                      AlternatingRowBackground="#F9FAFB"
                      HeadersVisibility="Column"
                      SelectionMode="Single"
                      CanUserResizeRows="False"
                      Margin="4">

                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#F3F4F6"/>
                        <Setter Property="Foreground" Value="#374151"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="FontSize" Value="12"/>
                        <Setter Property="Padding" Value="12,8"/>
                        <Setter Property="BorderThickness" Value="0"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>

                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="FontSize" Value="13"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#EFF6FF"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>

               
					<DataGrid.Columns>

						<DataGridTextColumn Header="Nº"
											Binding="{Binding Id}"
											Width="60">
							<DataGridTextColumn.ElementStyle>
								<Style TargetType="TextBlock">
									<Setter Property="Padding" Value="12,8"/>
									<Setter Property="FontWeight" Value="SemiBold"/>
									<Setter Property="Foreground" Value="#1B2A4A"/>
								</Style>
							</DataGridTextColumn.ElementStyle>
						</DataGridTextColumn>

						<DataGridTextColumn Header="Data / Hora"
											Binding="{Binding Data, StringFormat=dd/MM/yyyy HH:mm}"
											Width="150">
							<DataGridTextColumn.ElementStyle>
								<Style TargetType="TextBlock">
									<Setter Property="Padding" Value="12,8"/>
								</Style>
							</DataGridTextColumn.ElementStyle>
						</DataGridTextColumn>

						<DataGridTextColumn Header="Produtos"
											Binding="{Binding ResumoItens}"
											Width="*">
							<DataGridTextColumn.ElementStyle>
								<Style TargetType="TextBlock">
									<Setter Property="Padding" Value="12,8"/>
									<Setter Property="TextTrimming" Value="CharacterEllipsis"/>
								</Style>
							</DataGridTextColumn.ElementStyle>
						</DataGridTextColumn>

						<DataGridTextColumn Header="Qtd."
											Binding="{Binding TotalItens}"
											Width="60">
							<DataGridTextColumn.ElementStyle>
								<Style TargetType="TextBlock">
									<Setter Property="Padding" Value="12,8"/>
									<Setter Property="TextAlignment" Value="Center"/>
								</Style>
							</DataGridTextColumn.ElementStyle>
						</DataGridTextColumn>

						<DataGridTextColumn Header="Total"
											Binding="{Binding ValorTotal, StringFormat=C2}"
											Width="120">
							<DataGridTextColumn.ElementStyle>
								<Style TargetType="TextBlock">
									<Setter Property="Padding" Value="12,8"/>
									<Setter Property="FontWeight" Value="SemiBold"/>
									<Setter Property="Foreground" Value="#065F46"/>
								</Style>
							</DataGridTextColumn.ElementStyle>
						</DataGridTextColumn>

						<!-- Recibo -->
						<DataGridTemplateColumn Header="Recibo" Width="75">
							<DataGridTemplateColumn.CellTemplate>
								<DataTemplate>
									<Button Content="PDF"
											Height="26" Padding="8,0" FontSize="11"
											Foreground="White" Background="#1B2A4A"
											BorderThickness="0" Cursor="Hand"
											Margin="4,3" Tag="{Binding}"
											Click="BtnGerarRecibo_Click">
										<Button.Template>
											<ControlTemplate TargetType="Button">
												<Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="5">
													<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
												</Border>
												<ControlTemplate.Triggers>
													<Trigger Property="IsMouseOver" Value="True">
														<Setter TargetName="b" Property="Background" Value="#243460"/>
													</Trigger>
												</ControlTemplate.Triggers>
											</ControlTemplate>
										</Button.Template>
									</Button>
								</DataTemplate>
							</DataGridTemplateColumn.CellTemplate>
						</DataGridTemplateColumn>

						<!-- Nota Fiscal -->
						<DataGridTemplateColumn Header="NF" Width="60">
							<DataGridTemplateColumn.CellTemplate>
								<DataTemplate>
									<Button Content="NF"
											Height="26" Padding="8,0" FontSize="11"
											Foreground="White" Background="#1A5276"
											BorderThickness="0" Cursor="Hand"
											Margin="4,3" Tag="{Binding}"
											Click="BtnEmitirNf_Click">
										<Button.Template>
											<ControlTemplate TargetType="Button">
												<Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="5">
													<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
												</Border>
												<ControlTemplate.Triggers>
													<Trigger Property="IsMouseOver" Value="True">
														<Setter TargetName="b" Property="Background" Value="#154360"/>
													</Trigger>
												</ControlTemplate.Triggers>
											</ControlTemplate>
										</Button.Template>
									</Button>
								</DataTemplate>
							</DataGridTemplateColumn.CellTemplate>
						</DataGridTemplateColumn>

						<!-- Excluir — só Admin, controlado por código -->
						<DataGridTemplateColumn x:Name="ColExcluir" Header="Excluir" Width="80" Visibility="Collapsed">
							<DataGridTemplateColumn.CellTemplate>
								<DataTemplate>
									<Button Content="Excluir"
											Height="26" Padding="8,0" FontSize="11"
											Foreground="White" Background="#C0392B"
											BorderThickness="0" Cursor="Hand"
											Margin="4,3" Tag="{Binding}"
											Click="BtnExcluir_Click">
										<Button.Template>
											<ControlTemplate TargetType="Button">
												<Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="5">
													<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
												</Border>
												<ControlTemplate.Triggers>
													<Trigger Property="IsMouseOver" Value="True">
														<Setter TargetName="b" Property="Background" Value="#A93226"/>
													</Trigger>
												</ControlTemplate.Triggers>
											</ControlTemplate>
										</Button.Template>
									</Button>
								</DataTemplate>
							</DataGridTemplateColumn.CellTemplate>
						</DataGridTemplateColumn>

					</DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- RODAPÉ -->
        <Border Grid.Row="3"
                Background="White"
                CornerRadius="8"
                Padding="14,10">
            <Grid>
                <TextBlock x:Name="TxtRodape"
                           FontSize="12"
                           Foreground="#6B7280"
                           VerticalAlignment="Center"/>
                <TextBlock x:Name="TxtTotalGeral"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="#1B2A4A"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>

    </Grid>
</Window>