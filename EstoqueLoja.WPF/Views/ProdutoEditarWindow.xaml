<Window x:Class="EstoqueLoja.WPF.Views.ProdutoEditarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Editar Produto"
        Height="480"
        Width="450"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="White">

    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Editar Produto"
                   FontSize="24"
                   FontWeight="Bold"
                   Margin="0,0,0,20"/>
        
        <ScrollViewer Grid.Row="1"
              VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <TextBlock Text="Referência"/>
            <TextBox x:Name="TxtRef" Height="30" Margin="0,0,0,10"/>

            <TextBlock Text="Nome"/>
            <TextBox x:Name="TxtNome" Height="30" Margin="0,0,0,10"/>

            <TextBlock Text="Descrição"/>
            <TextBox x:Name="TxtDescricao" Height="60" Margin="0,0,0,10"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"/>

            <TextBlock Text="Tipo"/>
            <TextBox x:Name="TxtTipo" Height="30" Margin="0,0,0,10"/>

            <TextBlock Text="Valor Compra"/>
            <TextBox x:Name="TxtValorCompra" Height="30" Margin="0,0,0,10"/>

            <TextBlock Text="Valor Venda"/>
            <TextBox x:Name="TxtValorVenda" Height="30" Margin="0,0,0,10"/>

        </StackPanel>

        </ScrollViewer>
    
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,20,0,0">

            <Button Content="Cancelar"
                    Width="90"
                    Height="32"
                    Margin="0,0,10,0"
                    Click="BtnCancelar_Click"/>

            <Button Content="Salvar"
                    Width="90"
                    Height="32"
                    Click="BtnSalvar_Click"/>
        </StackPanel>
    </Grid>
</Window>