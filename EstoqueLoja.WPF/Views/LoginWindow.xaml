<Window x:Class="EstoqueLoja.WPF.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Estoque Lojas Diamante"
        Height="560" Width="420"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#EEF0F5"
        FontFamily="Segoe UI">

    <Window.Resources>

        <!-- Cores principais -->
        <SolidColorBrush x:Key="NavyBrush"       Color="#1B2A4A"/>
        <SolidColorBrush x:Key="NavyHoverBrush"  Color="#243460"/>
        <SolidColorBrush x:Key="AccentBrush"     Color="#2D4F9E"/>
        <SolidColorBrush x:Key="BorderBrush"     Color="#D0D5E0"/>
        <SolidColorBrush x:Key="MutedTextBrush"  Color="#7A8499"/>
        <SolidColorBrush x:Key="ErrorBrush"      Color="#C0392B"/>

        <!-- Estilo da aba ativa -->
        <Style x:Key="TabActiveStyle" TargetType="RadioButton">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border"
                                Background="#1B2A4A"
                                CornerRadius="6"
                                Padding="0,8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="False">
                                <Setter TargetName="border" Property="Background" Value="Transparent"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E5E8EF"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsChecked" Value="True"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="border" Property="Background" Value="#243460"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Foreground" Value="#7A8499"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Estilo do TextBox -->
        <Style x:Key="InputStyle" TargetType="TextBox">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#1B2A4A"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D0D5E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#1B2A4A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo do PasswordBox -->
        <Style x:Key="PasswordStyle" TargetType="PasswordBox">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#1B2A4A"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D0D5E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#1B2A4A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botão primário -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Height" Value="44"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#1B2A4A"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#243460"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#152038"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Link button -->
        <Style x:Key="LinkButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#1B2A4A"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <TextBlock x:Name="tb"
                                   Text="{TemplateBinding Content}"
                                   TextDecorations="Underline"
                                   Foreground="{TemplateBinding Foreground}"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="tb" Property="Foreground" Value="#2D4F9E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid>
        <!-- Barra de título customizada -->
        <Grid.RowDefinitions>
            <RowDefinition Height="36"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="28"/>
        </Grid.RowDefinitions>

        <!-- Título -->
        <Border Grid.Row="0" Background="#1B2A4A">
            <TextBlock Text="Estoque Lojas Diamante"
                       Foreground="White"
                       FontSize="12"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
        </Border>

        <!-- Conteúdo principal -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="40,28,40,24">

                <!-- Logo -->
                <StackPanel HorizontalAlignment="Center" Margin="0,0,0,20">
                    <Border Width="56" Height="56"
                            Background="#1B2A4A"
                            CornerRadius="12"
                            HorizontalAlignment="Center">
                        <Viewbox Width="32" Height="32">
                            <Canvas Width="24" Height="24">
                                <!-- Losango (diamante) -->
                                <Polygon Points="12,2 22,12 12,22 2,12"
                                         Fill="Transparent"
                                         Stroke="White"
                                         StrokeThickness="1.8"/>
                                <Polygon Points="12,6 18,12 12,18 6,12"
                                         Fill="White"
                                         Opacity="0.25"/>
                                <Line X1="2" Y1="12" X2="22" Y2="12"
                                      Stroke="White" StrokeThickness="1.2" Opacity="0.5"/>
                                <Line X1="12" Y1="2" X2="12" Y2="22"
                                      Stroke="White" StrokeThickness="1.2" Opacity="0.5"/>
                            </Canvas>
                        </Viewbox>
                    </Border>

                    <TextBlock Text="Estoque Lojas Diamante"
                               FontSize="16" FontWeight="Bold"
                               Foreground="#1B2A4A"
                               HorizontalAlignment="Center"
                               Margin="0,10,0,2"/>
                    <TextBlock Text="Sistema de Controle de Estoque"
                               FontSize="11" Foreground="#7A8499"
                               HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- Card do formulário -->
                <Border Background="White"
                        CornerRadius="12"
                        Padding="24,22">
                    <Border.Effect>
                        <DropShadowEffect Color="#1B2A4A" Opacity="0.08"
                                          BlurRadius="20" ShadowDepth="4" Direction="270"/>
                    </Border.Effect>
                    <StackPanel>

                        <!-- Título do card -->
                        <TextBlock x:Name="CardTitle"
                                   Text="Bem-vindo!"
                                   FontSize="17" FontWeight="Bold"
                                   Foreground="#1B2A4A"
                                   Margin="0,0,0,2"/>
                        <TextBlock x:Name="CardSubtitle"
                                   Text="Faça login para continuar"
                                   FontSize="12" Foreground="#7A8499"
                                   Margin="0,0,0,16"/>

                        <!-- Abas Usuario / Admin -->
                        <Border Background="#F2F4F8" CornerRadius="8" Padding="4" Margin="0,0,0,20">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <RadioButton x:Name="TabUsuario"
                                             Grid.Column="0"
                                             Content="Usuário"
                                             GroupName="Perfil"
                                             IsChecked="True"
                                             Style="{StaticResource TabActiveStyle}"
                                             Checked="TabUsuario_Checked"/>
                                <RadioButton x:Name="TabAdmin"
                                             Grid.Column="1"
                                             Content="Admin"
                                             GroupName="Perfil"
                                             Style="{StaticResource TabActiveStyle}"
                                             Checked="TabAdmin_Checked"/>
                            </Grid>
                        </Border>

                        <!-- Aviso Admin -->
                        <Border x:Name="AdminWarning"
                                Background="#EBF0FB"
                                BorderBrush="#C5D3F0"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="12,10"
                                Margin="0,0,0,14"
                                Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="Nível de acesso elevado."
                                           FontSize="12" FontWeight="SemiBold"
                                           Foreground="#1B2A4A"/>
                                <TextBlock Text="Todas as ações ficam no log do sistema."
                                           FontSize="11" Foreground="#4A6090"
                                           Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Campos -->
                        <TextBlock x:Name="LabelUsuario"
                                   Text="Usuário "
                                   FontSize="11" Foreground="#7A8499"
                                   Margin="0,0,0,5"/>
                        <TextBox x:Name="TxtUsuario"
                                 Style="{StaticResource InputStyle}"
                                 Margin="0,0,0,14"/>

                        <TextBlock Text="Senha"
                                   FontSize="11" Foreground="#7A8499"
                                   Margin="0,0,0,5"/>
                        <PasswordBox x:Name="TxtSenha"
                                     Style="{StaticResource PasswordStyle}"
                                     Margin="0,0,0,6"/>

                        <!-- Erro -->
                        <TextBlock x:Name="TxtErro"
                                   Foreground="#C0392B"
                                   FontSize="11"
                                   Visibility="Collapsed"
                                   Margin="0,0,0,8"
                                   TextWrapping="Wrap"/>

                        <!-- Botão entrar -->
                        <Button x:Name="BtnEntrar"
                                Content="Entrar"
                                Style="{StaticResource PrimaryButton}"
                                Margin="0,8,0,12"
                                Click="BtnEntrar_Click"/>

                        <Button Content="Esqueci minha senha"
                                Style="{StaticResource LinkButton}"
                                HorizontalAlignment="Center"/>

                    </StackPanel>
                </Border>

                <!-- Rodapé info -->
                <Border Background="White"
                        CornerRadius="8"
                        Padding="14,10"
                        Margin="0,12,0,0">
                    <Border.Effect>
                        <DropShadowEffect Color="#1B2A4A" Opacity="0.05"
                                          BlurRadius="10" ShadowDepth="2" Direction="270"/>
                    </Border.Effect>
                    <TextBlock x:Name="TxtRodapeInfo"
                               Text="Usuário: visualizar estoque e registrar movimentações."
                               FontSize="11" Foreground="#7A8499"
                               TextWrapping="Wrap"/>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Status bar -->
        <Border Grid.Row="2" Background="#1B2A4A">
            <Grid Margin="16,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="7" Height="7" Fill="#2ECC71" Margin="0,0,6,0"/>
                    <TextBlock Text="Conectado" Foreground="White" FontSize="10"/>
                </StackPanel>
                <TextBlock Text="v1.0.0"
                           Foreground="#7A9ACC"
                           FontSize="10"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
