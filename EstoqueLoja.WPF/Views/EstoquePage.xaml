<Page x:Class="EstoqueLoja.WPF.Views.EstoquePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="White">

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- TÍTULO -->
        <TextBlock Grid.Row="0"
                   Text="Estoque"
                   FontSize="26"
                   FontWeight="Bold"
                   Margin="0,0,0,20"/>

        <!-- PESQUISA E FILTRO -->
        <Grid Grid.Row="1"
              Margin="0,0,0,15">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="15"/>
                <ColumnDefinition Width="160"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- PESQUISA -->
            <Grid Grid.Column="0">

                <TextBox x:Name="TxtBusca"
                         Height="28"
                         VerticalContentAlignment="Center"
                         TextChanged="TxtBusca_TextChanged"/>

                <TextBlock Text="Pesquisar por nome ou referência..."
                           Foreground="#9CA3AF"
                           Margin="8,0,0,0"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False">

                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility"
                                    Value="Collapsed"/>

                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=TxtBusca}"
                                             Value="">
                                    <Setter Property="Visibility"
                                            Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>

                        </Style>
                    </TextBlock.Style>

                </TextBlock>

            </Grid>

            <!-- FILTRO -->
            <ComboBox x:Name="CmbTipo"
                      Grid.Column="2"
                      Height="28"
                      SelectionChanged="CmbTipo_SelectionChanged">

                <ComboBoxItem Content="Todos"
                              IsSelected="True"/>

                <ComboBoxItem Content="cadeira"/>
                <ComboBoxItem Content="mesa"/>

            </ComboBox>

        </Grid>

        <!-- RESUMO -->
        <Border Grid.Row="2"
                Background="#F3F4F6"
                Padding="10"
                CornerRadius="8"
                Margin="0,0,0,15">

            <StackPanel Orientation="Horizontal">

                <TextBlock x:Name="TxtTotalItens"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Margin="0,0,25,0"/>

                <TextBlock x:Name="TxtValorTotalEstoque"
                           FontSize="15"
                           FontWeight="SemiBold"/>

            </StackPanel>

        </Border>

        <!-- TABELA -->
        <DataGrid Grid.Row="3"
                  x:Name="GridEstoque"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  VerticalAlignment="Stretch"
                  HorizontalAlignment="Stretch">

            <DataGrid.Columns>

                <DataGridTextColumn Header="ID"
                                    Binding="{Binding ProdutoId}"
                                    Width="70"/>

                <DataGridTextColumn Header="Ref"
                                    Binding="{Binding Ref}"
                                    Width="120"/>

                <DataGridTextColumn Header="Nome"
                                    Binding="{Binding Nome}"
                                    Width="*"/>

                <DataGridTextColumn Header="Tipo"
                                    Binding="{Binding Tipo}"
                                    Width="120"/>

                <DataGridTextColumn Header="Quantidade"
                                    Binding="{Binding Quantidade}"
                                    Width="100"/>

                <DataGridTextColumn Header="Valor Venda"
                                    Binding="{Binding ValorVenda}"
                                    Width="120"/>

                <DataGridTextColumn Header="Total"
                                    Binding="{Binding ValorTotal}"
                                    Width="120"/>

            </DataGrid.Columns>

        </DataGrid>

    </Grid>

</Page>