<Window x:Class="EstoqueLoja.WPF.Views.NotaFiscalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Emitir Nota Fiscal — Loja Diamante"
        Height="640" Width="540"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F3F4F6"
        FontFamily="Segoe UI">

    <Window.Resources>
        <Style x:Key="SecTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#1A5276"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="0,12,0,6"/>
        </Style>
        <Style x:Key="Lbl" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#4B5563"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
        </Style>
        <Style x:Key="Inp" TargetType="TextBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="5">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#1A5276"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PBtn" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#1A5276"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#154360"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SBtn" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#F3F4F6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#1A5276" Padding="20,14">
            <StackPanel>
                <TextBlock Text="LOJA DIAMANTE — NOTA FISCAL"
                           FontSize="18" FontWeight="Bold" Foreground="White"/>
                <TextBlock Text="Preencha os dados do destinatário para emitir a NF"
                           FontSize="11" Foreground="#AED6F1" Margin="0,3,0,0"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20,0">
            <StackPanel Margin="0,4,0,16">

                <TextBlock Text="DADOS DO DESTINATÁRIO" Style="{StaticResource SecTitle}"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="150"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Nome / Razão Social" Style="{StaticResource Lbl}"/>
                        <TextBox x:Name="TxtNome" Style="{StaticResource Inp}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="CPF / CNPJ" Style="{StaticResource Lbl}"/>
                        <TextBox x:Name="TxtCpf" Style="{StaticResource Inp}"/>
                    </StackPanel>
                </Grid>

                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="120"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Telefone / Fax" Style="{StaticResource Lbl}"/>
                        <TextBox x:Name="TxtTel" Style="{StaticResource Inp}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Vendedor" Style="{StaticResource Lbl}"/>
                        <TextBox x:Name="TxtVendedor" Style="{StaticResource Inp}"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="ENDEREÇO DO DESTINATÁRIO" Style="{StaticResource SecTitle}"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="80"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Endereço" Style="{StaticResource Lbl}"/>
                        <TextBox x:Name="TxtEnd" Style="{StaticResource Inp}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Número" Style="{StaticResource Lbl}"/>
                        <TextBox x:Name="TxtNum" Style="{StaticResource Inp}"/>
                    </StackPanel>
                </Grid>

                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="50"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="80"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Bairro" Style="{StaticResource Lbl}"/>
                        <TextBox x:Name="TxtBairro" Style="{StaticResource Inp}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Município" Style="{StaticResource Lbl}"/>
                        <TextBox x:Name="TxtMun" Style="{StaticResource Inp}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="UF" Style="{StaticResource Lbl}"/>
                        <TextBox x:Name="TxtUf" Style="{StaticResource Inp}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="6">
                        <TextBlock Text="CEP" Style="{StaticResource Lbl}"/>
                        <TextBox x:Name="TxtCep" Style="{StaticResource Inp}"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="PAGAMENTO E OPERAÇÃO" Style="{StaticResource SecTitle}"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="120"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Natureza da Operação" Style="{StaticResource Lbl}"/>
                        <TextBox x:Name="TxtNatureza"
                                 Style="{StaticResource Inp}"
                                 Text="VENDA DE MERCADORIAS DENTRO"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Forma de Pagamento" Style="{StaticResource Lbl}"/>
                        <ComboBox x:Name="CmbPag" Height="32" FontSize="12" SelectedIndex="0">
                            <ComboBoxItem Content="À Vista"/>
                            <ComboBoxItem Content="Cartão"/>
                            <ComboBoxItem Content="Boleto"/>
                            <ComboBoxItem Content="Pix"/>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Desconto (R$)" Style="{StaticResource Lbl}"/>
                        <TextBox x:Name="TxtDesc" Style="{StaticResource Inp}" Text="0,00"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="OBSERVAÇÕES / DADOS ADICIONAIS" Style="{StaticResource SecTitle}"/>
                <TextBox x:Name="TxtObs" Height="60" Padding="8,6" FontSize="12"
                         AcceptsReturn="True" TextWrapping="Wrap"
                         BorderBrush="#D1D5DB" Background="White"
                         VerticalScrollBarVisibility="Auto">
                    <TextBox.Template>
                        <ControlTemplate TargetType="TextBox">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1" CornerRadius="5">
                                <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                            </Border>
                        </ControlTemplate>
                    </TextBox.Template>
                </TextBox>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Background="White" BorderBrush="#E5E7EB"
                BorderThickness="0,1,0,0" Padding="20,14">
            <Grid>
                <Button Content="Cancelar" Style="{StaticResource SBtn}"
                        Width="100" HorizontalAlignment="Left"
                        Click="BtnCancelar_Click"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="🖨  Imprimir" Style="{StaticResource SBtn}"
                            Width="120" Margin="0,0,10,0"
                            Click="BtnImprimir_Click"/>
                    <Button Content="💾  Salvar PDF" Style="{StaticResource PBtn}"
                            Width="130" Click="BtnSalvarPdf_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>